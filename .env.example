# ==============================================================================
# Treads - Environment Variables Configuration
# ==============================================================================

# 1. Google AI Studio (Required for Gemma 4 vision identification, sensory prompts & naturalist dispatch)
# Get an API key at: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides (Defaults to 'gemma-4-26b-a4b-it')
IDENTIFY_MODEL_ID=gemma-4-26b-a4b-it
FACTS_MODEL_ID=gemma-4-26b-a4b-it

# 2. ElevenLabs (Required for voice notes audio transcription)
# Get an API key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# 3. OpenRouteService (Required for pedestrian walking loop and routing generation)
# Get a free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# 4. Upstash Redis (Optional - for distributed sliding-window rate limiting in production)
# In development or single-instance deployments without Redis, falls back gracefully to in-memory rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
